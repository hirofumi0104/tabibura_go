<div class="admin-top-container">
  <div class="admin-top-columns">
    <div class="admin-reported-posts">
      <h2>通報された投稿一覧</h2>

      <% if @reported_posts.any? %>
        <% @reported_posts.each do |post| %>
          <div class="admin-post-card">
            <div class="admin-post-card-body">
              <div class="admin-post-info">
                <strong>投稿者:</strong>
                <%= link_to post.user.name, admin_users_path(search: post.user.name), class: "admin-link" %><br>
                <%= link_to post.caption, public_post_path(post), class: "admin-link" %><br>
              </div>

              <%= form_for post, url: update_status_public_post_path(post), method: :patch do |f| %>
                <div class="admin-radio-group">
                  <%= f.radio_button :status, 'published', id: "published_#{post.id}" %>
                  <%= f.label "published_#{post.id}", '公開する', class: "admin-radio-label" %>

                  <%= f.radio_button :status, 'unpublished', id: "unpublished_#{post.id}" %>
                  <%= f.label "unpublished_#{post.id}", '非公開にする', class: "admin-radio-label" %>
                </div>

                <%= f.submit '更新', class: 'admin-btn admin-btn-update' %>
              <% end %>

              <div class="admin-report-count">
                <strong>通報件数:</strong> <%= post.reports.count %>
              </div>

              <div class="admin-post-actions">
                <%= form_for post, url: admin_delete_reported_post_path(post), method: :delete, data: { confirm: '本当に削除しますか？' } do |f| %>
                  <%= f.submit '投稿を削除する', class: 'admin-btn admin-btn-danger' %>
                <% end %>

                <%= form_for post, url: cancel_report_report_path(post), method: :patch do |f| %>
                  <%= f.hidden_field :reported, value: false %>
                  <%= f.submit '通報を取り消す', class: 'admin-btn admin-btn-warning' %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <p>まだ通報された投稿がありません。</p>
      <% end %>
    </div>

    <div class="admin-reported-comments">
      <h2>通報されたコメント一覧</h2>

      <% if @reported_comments.any? %>
        <% @reported_comments.each do |comment| %>
          <div class="admin-comment-card">
            <div class="admin-comment-card-body">
              <div class="admin-comment-info">
                <strong>コメント投稿者:</strong>
                <%= link_to comment.user.name, admin_users_path(search: comment.user.name), class: "admin-link" %><br>
                <strong>通報されたコメント:</strong><br>
                <%= link_to truncate(comment.content, length: 50), post_path(comment.post), class: "admin-link" %><br>
              </div>

              <div class="admin-comment-reason">
                <strong>通報内容:</strong><br>
                <% if comment.reports.any? %>
                  <%= comment.reports.first.reason %>
                <% else %>
                  <p>通報内容がありません。</p>
                <% end %>
              </div>

              <div class="admin-report-count">
                <strong>通報件数:</strong> <%= comment.reports.count %>
              </div>

              <div class="admin-comment-actions">
                <%= link_to 'コメント削除', post_comment_path(comment.post, comment), method: :delete, data: { confirm: '本当にこのコメントを削除しますか？' }, class: 'admin-btn admin-btn-danger' %>

                <%= form_for comment, url: cancel_comment_report_path(comment.id), method: :patch do |f| %>
                  <%= f.submit '通報を取り消す', class: 'admin-btn admin-btn-warning' %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <p>まだ通報されたコメントがありません。</p>
      <% end %>
    </div>
  </div>
</div>
