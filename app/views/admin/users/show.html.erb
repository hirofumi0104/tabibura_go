<div class="admin-user-mypage-container">
  <h1 class="admin-user-mypage-title">ユーザーのマイページ</h1>

  <div class="admin-profile-section">
    <% if @user.profile_image.attached? %>
      <%= image_tag rails_blob_path(@user.profile_image, only_path: true), class: "admin-profile-image", size: "100x100" %>
    <% else %>
      <%= image_tag "User.png", class: "admin-profile-image", alt: "デフォルトアイコン" %>
    <% end %>
    <h2 class="admin-profile-name"><%= @user.name %></h2>
    <p class="admin-profile-bio"><%= @user.biography %></p>
  </div>

  <h2 class="admin-posts-title">ユーザーの投稿</h2>

  <%= form_with(url: admin_user_path(@user), method: :get, local: true, class: "admin-posts-filter") do %>
    <%= select_tag :itinerary, options_for_select(itinerary, params[:itinerary]), include_blank: '投稿場所選択', class: 'admin-select mb-2' %>
    <%= submit_tag '検索', class: 'admin-btn admin-btn-primary mb-3' %>
  <% end %>

  <div class="admin-posts-grid">
    <% if @posts.any? %>
      <% @posts.each_slice(3) do |post_slice| %>
        <% post_slice.each do |post| %>
          <div class="admin-post-card">
            <div class="admin-post-card-inner">
              <%= image_tag post.main_image, class: "admin-post-image", alt: "投稿画像" %>
              <div class="admin-post-card-body">
                <h5 class="admin-post-itinerary"><%= post.itinerary %></h5>
                <p class="admin-post-caption"><%= truncate(post.caption, length: 20) %></p>

                <%= form_for post, url: update_status_public_post_path(post), method: :patch, class: "admin-post-status-form" do |f| %>
                  <div class="admin-radio-group">
                    <div class="admin-radio">
                      <%= f.radio_button :status, 'published', id: "status_published_#{post.id}" %>
                      <%= f.label "status_published_#{post.id}", '公開する', class: "admin-radio-label" %>
                    </div>
                    <div class="admin-radio">
                      <%= f.radio_button :status, 'unpublished', id: "status_unpublished_#{post.id}" %>
                      <%= f.label "status_unpublished_#{post.id}", '非公開にする', class: "admin-radio-label" %>
                    </div>
                  </div>
                  <%= f.submit '更新', class: 'admin-btn admin-btn-update' %>
                <% end %>

                <%= link_to "詳細を見る", public_post_path(post.id), class: 'admin-btn admin-btn-secondary' %>

                <%= form_for post, url: admin_delete_reported_post_path(post), method: :delete, data: { confirm: '本当に削除しますか？' } do |f| %>
                  <%= f.submit '投稿を削除する', class: 'admin-btn admin-btn-danger' %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <p class="admin-no-posts">投稿はありません。</p>
    <% end %>
  </div>
</div>
