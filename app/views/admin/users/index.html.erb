<div class="admin-users-container">
  <h1>ユーザー一覧</h1>

  <%= form_tag(admin_users_path, method: :get, class: "admin-users-search") do %>
    <div class="admin-users-search-group">
      <%= text_field_tag :search, params[:search], class: "admin-input", placeholder: "ユーザー名で検索する" %>
      <button type="submit" class="admin-btn admin-btn-primary">検索</button>
    </div>
  <% end %>

  <div class="admin-users-filters">
    <%= link_to 'すべてのユーザー', admin_users_path, class: 'admin-btn admin-btn-outline-secondary' %>
    <%= link_to 'ログイン可能なユーザー', admin_users_path(status: 'active'), class: 'admin-btn admin-btn-outline-success' %>
    <%= link_to 'ログイン不可なユーザー', admin_users_path(status: 'inactive'), class: 'admin-btn admin-btn-outline-danger' %>
  </div>

  <div class="admin-users-table-container">
    <table class="admin-users-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th>Email</th>
          <th>ステータス</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if @users.any? %>
          <% @users.each do |user| %>
            <tr>
              <td><%= user.id %></td>
              <td><%= link_to user.name, admin_user_path(user), class: "admin-link" %></td>
              <td><%= user.email %></td>
              <td class="admin-text-center">
                <% if user.is_active %>
                  <span class="admin-badge admin-badge-success">ログイン可能</span>
                <% else %>
                  <span class="admin-badge admin-badge-danger">ログイン不可</span>
                <% end %>
              </td>
              <td class="admin-text-center">
                <% if user.is_active %>
                  <%= link_to 'ログイン不可に', deactivate_admin_user_path(user), method: :patch, class: 'admin-badge admin-badge-danger admin-badge-action', data: { confirm: 'このユーザーを無効にしますか？' } %>
                <% else %>
                  <%= link_to 'ログイン可能に', activate_admin_user_path(user), method: :patch, class: 'admin-badge admin-badge-success admin-badge-action', data: { confirm: 'このユーザーを有効にしますか？' } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="5">ユーザーがいません。</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
