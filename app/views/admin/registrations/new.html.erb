<div class="auth-card">
  <h2 class="card-title">Sign up</h2>
  <%= form_for(resource, as: resource_name, url: (request.path.starts_with?("/admin") ? new_admin_registration_path : registration_path(resource_name))) do |f| %>

    <%= render "admin/shared/error_messages", resource: resource %>

    <div class="form-group">
      <%= f.label :email %><br />
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :password %>
      <% if @minimum_password_length %>
      <em>(<%= @minimum_password_length %> characters minimum)</em>
      <% end %><br />
      <%= f.password_field :password, autocomplete: "new-password", class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :password_confirmation %><br />
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input" %>
    </div>

    <%= hidden_field_tag :user_type, 'admin' %>

    <div class="form-group">
      <%= f.submit "Sign up", class: "btn-submit" %>
    </div>
  <% end %>
  <%= render "admin/shared/links" %>
</div>
