<div>
  <h1>ようこそ旅ぶら_GOへ</h1>

  <% if @posts.present? %>
    <h3>新着投稿</h3>
    <% @posts.each do |post| %>
      <div>
        <% if post.main_image.attached? %>
          <%= image_tag post.main_image %>
        <% end %>
        <div>
          <p><%= link_to post.user.name, public_user_path(post.user.id) %></p>
          <p><%= post.itinerary %></p>
          <p><%= post.caption %></p>
          <%= link_to "詳細を見る", public_post_path(post.id) %>  
          <br>
          ーーーーーーーーーーーーーーーーーーーーーー
        </div>
      </div>
    <% end %>
  <% else %>
    <p>新着投稿はありません。</p>
  <% end %>

  <% if @recommended_posts.present? %>
    <h3>注目投稿</h3>
    <% @recommended_posts.each do |post| %>
      <div>
        <% if post.main_image.attached? %>
          <%= image_tag post.main_image %>
        <% end %>
        <div>
          <p><%= link_to post.user.name, public_user_path(post.user.id) %></p>
          <p><%= post.itinerary %></p>
          <p><%= post.caption %></p>
          <%= link_to "詳細を見る", public_post_path(post.id) %>
        </div>
      </div>
    <% end %>
  <% else %>
    <p>注目投稿はありません。</p>
  <% end %>

  <div>
    <%= link_to public_posts_path do %>
      投稿一覧ページへ
    <% end %>

    <% if user_signed_in? %>
      <%= link_to new_public_post_path do %>
        投稿ページへ
      <% end %>
    <% end %>
  </div>
</div>
