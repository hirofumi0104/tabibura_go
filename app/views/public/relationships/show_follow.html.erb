<div class="user-card">
  <div class="user-card-header">
    <h1><%= @user.name %>の<%= action_name == 'followers' ? 'フォロワー' : 'フォロー中' %></h1>
  </div>

  <div class="user-list-scroll">
    <% if @users.any? %>
      <ul class="user-list">
        <% @users.each do |user| %>
          <li class="user-list-item">
            <div class="user-info">
              <% if user.profile_image.present? %>
                <%= image_tag(user.profile_image, alt: user.name) %>
              <% else %>
                <%= image_tag("User.png", alt: "プロフィール画像がありません") %>
              <% end %>
              <%= link_to user.name, public_user_path(user) %>
            </div>

            <div class="user-actions">
              <%= link_to public_user_path(user), class: "user-btn", title: "プロフィールを見る" do %>
                <i class="fas fa-user"></i>
                <span>プロフィール</span>
              <% end %>

              <% unless current_user.nil? %>
                <%= render "layouts/followbtn", user: user, options: { class: "user-btn" } %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="user-card-empty">
        <p>フォローしているユーザーまたはフォロワーがいません。</p>
      </div>
    <% end %>
  </div>
</div>
