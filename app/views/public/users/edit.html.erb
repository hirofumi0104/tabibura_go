<div class="profile-edit-wrapper">
  <div class="profile-edit-card">
    <div class="profile-edit-body">
      <h1 class="profile-title">プロフィール編集</h1>

      <%= form_for([:public, @user], url: update_information_public_user_path(@user), html: { method: :patch, multipart: true }) do |f| %>

        <% if @user.errors.any? %>
          <div class="error-box">
            <h2><%= pluralize(@user.errors.count, "エラー") %>があります:</h2>
            <ul>
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="form-block">
          <%= f.label :name, "ユーザーネーム" %>
          <%= f.text_field :name, class: 'input-text', placeholder: 'ユーザーネームを入力してください' %>
        </div>

        <div class="form-block">
          <%= f.label :email, "メールアドレス" %>
          <%= f.email_field :email, class: 'input-text', placeholder: 'メールアドレスを入力してください' %>
        </div>

        <div class="form-block">
          <%= f.label :biography, "自己紹介" %>
          <%= f.text_area :biography, class: 'input-textarea', placeholder: '自己紹介を入力してください', rows: 4 %>
        </div>
        
        <div class="form-block">
          <%= f.label :profile_image, "プロフィール画像" %>
          <%= f.file_field :profile_image, class: 'input-file' %>
        </div>

        <div class="checkbox-block">
          <%= f.check_box :withdrawal_confirmation, id: 'withdrawal_confirmation', class: 'checkbox-input' %>
          <%= f.label :withdrawal_confirmation, "退会する場合はこちらをチェック", class: 'checkbox-label' %>
        </div>

        <div id="withdrawal-button" class="withdrawal-area" style="display: none;">
          <%= link_to "退会する", unsubscribe_public_user_path(@user), method: :delete, data: { confirm: "本当に退会しますか？" }, class: 'danger-button' %>
        </div>

        <div class="button-area">
          <%= f.submit "更新", class: 'primary-button' %>
          <%= link_to "戻る", :back, class: 'secondary-button' %>
        </div>
      <% end %>
    </div>
  </div>
</div>