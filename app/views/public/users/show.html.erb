<div class="mypage-container">
  <h1>マイページ</h1>

  <div class="mypage-layout">

    <%# !-- 左：サイドバー -- %>
    <div class="mypage-sidebar">
      <div class="mypage-profile">
        <% if @user.profile_image.attached? %>
          <%= image_tag rails_blob_path(@user.profile_image, only_path: true), size: "80x80" %>
        <% else %>
          <%= image_tag "User.png", size: "80x80", alt: "プロフィール画像" %>
        <% end %>

        <div class="mypage-user-info">
          <h4><%= @user.name %></h4>
          <p><%= @user.biography %></p>
        </div>
      </div>

      <div class="mypage-follow-stats">
        <div>
          <h5>フォロー</h5>
          <p><%= link_to @user.followings.count, public_user_followings_path(@user) %></p>
        </div>

        <div>
          <h5>フォロワー</h5>
          <p><%= link_to @user.followers.count, public_user_followers_path(@user) %></p>
        </div>
      </div>

      <div class="mypage-follow-button">
        <%= render "layouts/followbtn", user: @user %>
      </div>

      <% if current_user == @user %>
        <div class="mypage-actions">
          <%= link_to "会員情報編集", edit_information_public_user_path %>
          <%= link_to "すべて", public_user_path(@user, status: "all") %>
          <% if params[:status] != "published" %>
            <%= link_to "公開中", public_user_path(@user, status: "published") %>
          <% end %>

          <% if params[:status] != "unpublished" %>
            <%= link_to "非公開", public_user_path(@user, status: "unpublished") %>
          <% end %>
          <%= link_to "いいねした投稿一覧", nice_public_posts_path %>
        </div>
      <% end %>

      <div class="mypage-search">
        <%= form_with(url: public_user_path(@user), method: :get, local: true) do %>
          <%= select_tag :itinerary, options_for_select(itinerary, params[:itinerary]), include_blank: '旅先検索' %>
          <%= submit_tag '検索' %>
        <% end %>
      </div>

      <% if current_user == @user && @notifications.any? %>
        <div class="mypage-notifications">
          <h4>通知</h4>
          <ul>
            <% @notifications.each do |notification| %>
              <li>
                <% if notification.post.present? && notification.post.status == 'unpublished' && notification.comment.nil? %>
                  <%= link_to mark_as_read_and_destroy_public_notification_path(notification), method: :patch do %>
                    投稿「<strong><%= notification.post.caption %></strong>」が非公開になりました
                  <% end %>
                <% elsif notification.comment.present? %>
                  <%= link_to mark_as_read_and_destroy_public_notification_path(notification), method: :patch do %>
                    投稿「<strong><%= notification.comment.post.caption %></strong>」に新しいコメントが追加されました
                  <% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>

    <%# !-- 右：メイン（投稿一覧） -- %>
    <div class="mypage-main">
      <div class="mypage-post-grid">
        <% @posts.each do |post| %>
          <div class="mypage-post">
            <% if post.main_image.attached? %>
              <%= image_tag post.main_image %>
            <% else %>
              <%= image_tag "default_image.jpg" %>
            <% end %>
            <div class="mypage">
              <h5 class="mypage-post-catitineraryegory"><%= post.itinerary %></h5>
              <p class="mypage-post-caption"><%= truncate(post.caption, length: 20) %></p>
              <hr class="mypage-divider">
            </div>
            <% if current_user == @user %>
              <div class="mypage-post-status">
                <%= radio_button_tag "post_status_#{post.id}", "published", post.published? %>
                <%= label_tag "post_status_#{post.id}", "公開" %>

                <%= radio_button_tag "post_status_#{post.id}", "unpublished", !post.published? %>
                <%= label_tag "post_status_#{post.id}", "非公開" %>

                <%= button_to "更新", update_status_public_post_path(post),
                      method: :patch,
                      params: { post: { status: post.published? ? 'unpublished' : 'published' } },
                      remote: true, class: "btn-success" %>
              </div>

              <div class="mypage-post-actions">
                <%= link_to '編集', edit_public_post_path(post) %>
                <%= link_to '削除', public_post_path(post),
                      method: :delete,
                      data: { confirm: '本当に削除しますか？' } %>
                <%= link_to "詳細を見る", public_post_path(post.id) %>      
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
