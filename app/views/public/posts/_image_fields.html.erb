<!--投稿画面と編集画面のrender-->
<div class="nested-fields">
  <div class="form-sub-file">
    <label class="custom-file">
      <% if f.object.image.attached? %>
        📸 写真を変更する
      <% else %>
        📷 レポート写真を選ぶ
      <% end %>
      <%= f.file_field :image, class: "custom-file-input" %>
    </label>
  </div>

  <div class="description">
    <div>
      <%= f.text_area :description, class: 'form-description', placeholder: "レポート内容を入力してください" %>
    </div>
    <div class="form-destroy">
      <%= link_to 'レポート削除', '#', class: 'remove_fields' %>
      <%= f.hidden_field :_destroy %>
    </div>
  </div>
</div>
