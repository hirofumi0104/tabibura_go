<div class="draft-container">
  <h1 class="draft-title">下書き一覧</h1>

  <div class="draft-layout">
    <aside class="draft-sidebar">
      <div class="draft-card">
        <h5 class="draft-card-title">カテゴリ検索</h5>
        <%= form_with(url: draft_public_posts_path, method: :get, local: true, class: "draft-form") do |f| %>
          <%= f.select :itinerary, itinerary, 
                { include_blank: '旅先で検索', selected: '1' }, 
                class: "draft-select" %>
          <%= f.submit '検索', class: "draft-btn draft-btn-primary" %>
        <% end %>
      </div>
      <%= link_to "戻る", show_mypage_public_user_path(current_user), class: "secondary-button", style: "margin-top: 10px;" %>
    </aside>

    <main class="draft-main">
      <% if @posts.any? %>
        <div class="draft-posts">
          <% @posts.each do |post| %>
            <div class="draft-post">
              <%= link_to public_post_path(post.id) do %>
                <%= image_tag post.main_image, class: "draft-post-img" %>
              <% end %>
              <div class="draft-post-body">
                <h5 class="draft-post-category"><%= post.itinerary %></h5>
                <p class="draft-post-caption"><%= truncate(post.caption, length: 20) %></p>
                <hr class="draft-divider">

                <div class="draft-status">
                  <%= form_for post, url: update_status_public_post_path(post), method: :patch, class: "draft-status-form" do |f| %>

                    <div class="draft-radio-group">
                      <label class="draft-radio">
                        <%= f.radio_button :status, 'published' %> 公開
                      </label>
                      <label class="draft-radio">
                        <%= f.radio_button :status, 'unpublished' %> 非公開
                      </label>
                    </div>

                    <%= f.submit '更新', class: "draft-btn draft-btn-success" %>

                  <% end %>
                </div>

                <div class="draft-actions">
                  <%= link_to "詳細を見る", public_post_path(post.id), class: "draft-btn draft-btn" %>
                  <%= link_to '編集', edit_public_post_path(post), class: "draft-btn draft-btn" %>
                  <%= link_to '削除', public_post_path(post), method: :delete, data: { confirm: '本当に削除しますか？' }, class: 'draft-btn' %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="draft-empty">
          <p>下書きはありません。</p>
        </div>
      <% end %>

      <% if @posts.total_pages > 1 %>
        <nav class="draft-pagination">
          <%# ページネーションのコードは同じく置き換え %>
        </nav>
      <% end %>
    </main>
  </div>
</div>
