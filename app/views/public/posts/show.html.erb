<div class="posts-show-container">
  <h2 id="show-title"><%= @post.itinerary %>での旅ログ</h2>
  <div class="contents">

    <div class="user-all-posts">
      <h1 id="post-all-title">他の投稿</h1>
      <% @posts.each do |post| %>
        <div class="post-all-card">
          <%= image_tag post.main_image, id: "post-all-img" %>
          <%= link_to post.caption, public_post_path(post.id), id: "post-all-link" %>
        </div>
      <% end %>
      <% if current_user && !current_user.admin? %>
        <%= link_to 'もっと見る', params[:referrer] || public_user_path(@post.user), id: "mypage-link" %>
      <% end %>
    </div>

    <div class="post-show-contents">
      <h1 id="post-title"><%= @post.caption %></h1>
      <% if @post.main_image.attached? %>
        <span><%= image_tag @post.main_image, id: "post-main-img" %></span>
      <% end %>

      <hr>

      <% @post.images.each do |image| %>
        <% if image.image.attached? %>
          <div id="post-sub-img">
            <%= image_tag image.image, style: "object-fit: cover; width: 100%; max-height: 390px;" %>
            <div id="post-sub-text"><%= image.description %></div>
          </div>
        <% end %>
      <% end %>

      <div id="map" style="height: 500px;"></div>

      <% if current_user && !current_user.admin? %>
        <h5>タグ</h5>
        <% if @post.tags.any? %>
          <% @post.tags.each do |tag| %>
            <% display_name = tag.name.split('-').first %>
            <%= link_to "##{display_name}", public_posts_path(tag: display_name) %>
          <% end %>
        <% else %>
          <p>タグはありません</p>
        <% end %>
      <% end %>
    </div>

    <div>
      <h1 id="user-profile-title">プロフィール</h1>
      <div class="user-contents">
        <div class="post_user-card">
          <div class="card-contents">
            <span>
              <% if @post.user.profile_image.attached? %>
                <%= image_tag @post.user.profile_image, id: "profile_image" %>
              <% else %>
                <%= image_tag "User.png", id: "profile_image", alt: "デフォルトアイコン" %>
              <% end %>
            </span>
            <div>
              <% if current_user && current_user.admin? %>
                旅びと:<%= link_to @post.user.name, admin_user_path(@post.user) %>
              <% else %>
                旅びと:<%= link_to @post.user.name, public_user_path(@post.user.id) %>
              <% end %>
            </div>
            
            <% if @post.user.biography.present?%>
              <div id="biography"> 
                <%= @post.user.biography %> 
              </div>
            <% end %>

            <div id="follows-link">
              <div>
                <h5>フォロー</h5>
                <p><%= link_to @post.user.followings.count, public_user_followings_path(@post.user) %></p>
              </div>
              <div>
                <h5>フォロワー</h5>
                <p><%= link_to @post.user.followers.count, public_user_followers_path(@post.user) %></p>
              </div>
            </div>
          </div>
          <% if !current_user %>
            <div id="follow-button">
              <%= render "layouts/followbtn", user: @post.user %>
            </div>
          <% end %>
        </div>

        <div id="nice-button">
          投稿にいいね！<%= render partial: 'layouts/nice', locals: { post: @post } %>
        </div>

        <% if current_user && !current_user.admin? %>
          <div>
            <h2>投稿を通報</h2>
            <%= render partial: 'layouts/report', locals: { reportable: @post } %>
          </div>
        <% end %>

        <h3 id="comment-title">コメント覧</h3>
        <% if @post.comments.any? %>
          <% @post.comments.each do |comment| %>
            <div class="comment-contents">
              <div class="img-name">
                <% if comment.user && comment.user.profile_image.attached? %>
                  <%= image_tag comment.user.profile_image, id: "comment-profile-image" %>
                <% else %>
                  <%= image_tag "User.png", id: "comment-profile-image", alt: "デフォルトアイコン" %>
                <% end %>
                <div id="comment">
                    <%= link_to comment.user.name, public_user_path(comment.user) %>
                    <%= content_tag :span, comment.content, id: "comment-length" %>
                </div>
                <div class="comment-report-delete">
                  <% if comment.user != current_user %>
                    <!-- チェックボックス：トグルスイッチ -->
                    <input type="checkbox" id="report-toggle-<%= comment.id %>" class="report-toggle" hidden>

                    <!-- ボタン（ラベルでトグル） -->
                    <label for="report-toggle-<%= comment.id %>" class="report-button">通報する</label>

                    <!-- ポップアップ背景（モーダル） -->
                    <div class="modal">
                      <div class="modal-content">
                        <label for="report-toggle-<%= comment.id %>" class="close-button">&times;</label>
                        <%= render partial: 'layouts/report', locals: { reportable: comment } %>
                      </div>
                    </div>  
                  <% elsif  comment.user == current_user || current_user.role == 1 %>
                    <%= link_to '削除する', public_post_comment_path(@post, comment.id), method: :delete, data: { confirm: '本当に削除しますか？' }, class: "comment-delete-btn" %>
                  <% end %>
                </div>
              </div>        
              <hr>
            </div>
          <% end %>
        <% else %>
          <p>まだコメントがありません。</p>
        <% end %>
        
        <% if current_user && !current_user.admin? %>
          <%= render partial: 'public/comments/comments_form', locals: { post: @post } %>
        <% end %>
        
      </div>
    </div>
  </div>
</div>


<script>
function initMap() {
  var mapElement = document.getElementById('map');
  var initialPosition = { lat: 35.6895, lng: 139.6917 };

  var centerPosition;
  <% if @post.map.present? && @post.map.latitude.present? && @post.map.longitude.present? %>
    centerPosition = { lat: <%= @post.map.latitude %>, lng: <%= @post.map.longitude %> };
  <% else %>
    centerPosition = initialPosition;
  <% end %>

  var map = new google.maps.Map(mapElement, {
    center: centerPosition,
    zoom: 10
  });

  new google.maps.Marker({
    position: centerPosition,
    map: map,
    draggable: false
  });
}
</script>

<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyC61O9MImwW7WvEJ_zkkkD08jt_nhgwzPA&callback=initMap" async defer></script>
