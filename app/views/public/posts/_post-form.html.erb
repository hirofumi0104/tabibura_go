<div class="postform-container">
  <div class="post-form">
    <%= form_with(model: [:public, @post], local: true) do |form| %>
      <div class="form-top">
        <div>
          <% if @post.errors.any? %>
            <div id="error_explanation">
              <h2>入力をお願いします</h2>
              <ul>
                <% @post.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
        <div>
          <button type="button" id="preview-btn">
            プレビュー
          </button>
        </div>
      </div>
      

      <div class="form-theme">
        <h3><%= form.label :caption, "旅のテーマ（タイトルなど）" %></h3>
        <%= form.text_field :caption, class: 'title-form', rows: 6 %>
      </div>

      <h3 style="margin-block: 0; padding: 0 0 0 20px;"><%= form.label :main_image, "見出し写真" %>と<%= form.label :itinerary, "旅先" %></h3>
      <div class="form-main-photo-itinerary">
        <div class="file-main-photo">
          <%= form.file_field :main_image, class: 'form-main-photo' %>
        </div>
        
        <div class="form-select">
          <%= form.select :itinerary, options_for_select(itinerary), { prompt: "旅先を選択してください" }, id: 'itinerary_select', class: 'form-select' %>
        </div>
      </div>

      <div class="report-form">
        <h3>旅先レポート</h3>
        <div id="images">
          <%= form.fields_for :images do |image_form| %>
            <%= render 'public/posts/image_fields', f: image_form %>
          <% end %>
        </div>
        <%= link_to 'レポート追加', '#', class: 'add_fields',
          data: { id: 'image_form',
          fields: raw(form.fields_for(:images, Image.new, child_index: 'image_form') { |image_form| render('image_fields', f: image_form) }.gsub("\n", "")) } %>
      </div>

      <div class="map-search">  
        <h3>場所を検索(例: 東京都 丸の内)</h3>
        <div class="input-group">
          <input type="text" id="location" class="form-control">
          <div class="input-group-append">
            <button type="button" onclick="searchLocation()" class="btn btn-primary">検索</button>
          </div>
        </div>
      </div>

      <div 
        id="new-edit-map"
        data-pins='<%= raw(@post.map_pins.map { |pin| 
          { latitude: pin.latitude, longitude: pin.longitude, label: pin.label } 
        }.to_json) %>'
        style="width: 100%; height: 400px; border: 2px solid #ccc;">
      </div>
      
      <div class="form-bottom">
        <div class="tag">
          <h5><%= form.label :tag_list, "タグ (例: 旅行, 食べ物)" %></h5>
          <div>
            <% #!--  google cloud vision APIのタグ付け機能は一旦保留（お金がかかるから） 
            #   <label>
            #     <input type="radio" name="tagging_option" value="manual" checked>
            #     自分ででタグ付け
            #   </label>
            #   <label>
            #     <input type="radio" name="tagging_option" value="cloud_vision">
            #     AIでタグ付け(精度は低め)
            #   </label>
            -- %>
          </div>
          <%= form.text_field :tag_list, value: @post.tag_list.is_a?(Array) ? @post.tag_list.join(", ") : @post.tag_list, placeholder: "タグをカンマで区切って入力", class: 'tag-form', id: 'manual_tag_input' %>
        </div>
        
         <% 
          #!-- ピンの位置情報送信用 -
         - %>
        <div class="map-pins-fields-container"></div>

        <div class="submit">
          <%= button_tag(type: 'submit', name: 'submit_post', class: 'btn btn-primary mr-2') do %>
            <i class="fas fa-paper-plane"></i> 投稿
          <% end %>
          <%= button_tag(type: 'submit', name: 'save_as_draft', class: 'btn btn-secondary') do %>
            <i class="fas fa-save"></i> 下書きを保存
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- プレビュー -->
  <div id="preview-modal" class="modal">
    <div class="modal-content">
      <span class="close">&times;</span>
      
     <div id="preview-container">
        <div class="post-show-contents">
          <h1 id="post-title"></h1>
          <span id="post-main-img-container"></span>
          <hr>
          <div id="post-sub-imgs-container"></div>
          <div id="preview-map" style="width:100%; height:400px;"></div>
          <div id="post-tags-container"></div>
          <p id="preview-empty" style="text-align:center; display:none;">まだ内容がありません</p>
        </div>
      </div>

    </div>
  </div>
</div>