<div class="nice-container">
  <h1 class="nice-title">いいねした投稿一覧</h1>

  <div class="nice-layout">
    <aside class="nice-sidebar">
      <div class="nice-card">
        <%= form_with(url: nice_public_posts_path, method: :get, local: true, class: "nice-form") do |f| %>
          <%= f.select :itinerary, itinerary, 
                { include_blank: 'すべてのカテゴリ', selected: @itinerary }, 
                class: "nice-select" %>
          <%= f.submit '検索', class: "nice-btn nice-btn-primary" %>
        <% end %>
      </div>
       <%= link_to "戻る", show_mypage_public_user_path(current_user), class: "secondary-button", style: "margin-top: 10px;" %>
    </aside>

    <main class="nice-main">
      <% if @favorite_posts.present? %>
        <div class="nice-posts">
          <% @favorite_posts.each do |post| %>
            <div class="nice-post">
              <%= image_tag post.main_image, class: "nice-post-img" %>
              <div class="nice-post-body">
                <h5 class="nice-post-user"><%= link_to post.user.name, public_user_path(post.user) %></h5>
                <p class="nice-post-category"><%= post.itinerary %></p>
                <p class="nice-post-caption"><%= truncate(post.caption, length: 20) %></p>
                <hr class="nice-divider">

                <div class="nice-actions">
                  <%= link_to '詳細を見る', public_post_path(post), class: "nice-btn nice-btn-primary" %>
                  <%= button_to 'いいねを取り消す', public_post_favorites_path(post, current_user.favorites.find_by(post: post)), method: :delete, data: { confirm: '本当にいいねを取り消しますか？' }, class: "nice-btn nice-btn-danger" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <% if @favorite_posts.total_pages > 1 %>
          <nav class="nice-pagination">
          </nav>
        <% end %>
      <% else %>
        <div class="nice-empty">
          <p>まだいいねした投稿がありません。</p>
        </div>
      <% end %>
    </main>
  </div>
</div>
