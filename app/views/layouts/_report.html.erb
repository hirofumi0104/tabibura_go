<%= form_with(model: Report.new, url: reports_path, id: 'reportForm') do |form| %>
  <%= form.hidden_field :reportable_id, value: reportable.id %>
  <%= form.hidden_field :reportable_type, value: reportable.class.to_s %>
  <div class="form-group">
    <%= form.text_area :reason, placeholder: "ここに通報理由を書いてください", rows: 3, id: 'reasonField', required: true %>
  </div>
  <%= form.submit "通報する" %>
<% end %>
