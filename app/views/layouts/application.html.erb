<!DOCTYPE html>
<html>
  <head>
    <title>TabiburaGo</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <!-- TurboLinksを無効化 -->
    <meta name="turbo-visit-control" content="reload">
    <script src="https://kit.fontawesome.com/c875564d79.js" crossorigin="anonymous"></script>

    <script type="module" src="/assets/application.js"></script>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body style="margin: 0;">
    <%= render 'layouts/header' %>
     
    <% if notice.present? %>
      <div class="alert alert-notice"><%= notice %></div>
    <% end %>
    
    <% if alert.present? %>
      <div class="alert alert-alert"><%= alert %></div>
    <% end %>
    
    <%= yield %>
    
    <%= render 'layouts/footer' %>
  </body>
</html>
