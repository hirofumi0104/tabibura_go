<!DOCTYPE html>
<html style="margin: 0; height: 100%; overflow-x: hidden;">
  <head>
    <title>TabiburaGo</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <!-- TurboLinksを無効化 -->
    <meta name="turbo-visit-control" content="reload">
    <script src="https://kit.fontawesome.com/c875564d79.js" crossorigin="anonymous"></script>

    <script type="module" src="/assets/application.js"></script>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&family=M+PLUS+Rounded+1c:wght@400;700&family=Kosugi+Maru&family=Shippori+Mincho&display=swap" rel="stylesheet">

    <!-- map関連 -->
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    
  </head>

  <body style="margin: 0; height: 100%; width: 100%;">
    <div class="wrapper">
      <%= render 'layouts/header' %>
      <main class="content">
        <% if notice.present? %>
          <div class="alert alert-notice"><%= notice %></div>
        <% end %>
        
        <% if alert.present? %>
          <div class="alert alert-alert"><%= alert %></div>
        <% end %>
        
        <%= yield %>
      </main>
      <%= render 'layouts/footer' %>
    </div>
  </body>
</html>
